---
import FihLayout from '~/layouts/FihLayout.astro';
import InkAtmosphere from '~/components/brand/InkAtmosphere.astro';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

Astro.response.status = 500;

const title = 'Server error';
---

<FihLayout metadata={{ title }}>
  <section
    class="section"
    style="min-height: 60dvh; display: flex; align-items: center; position: relative"
  >
    <InkAtmosphere washes={1} opacity={0.2} />
    <div class="container" style="text-align: center; position: relative; z-index: 2">
      <p class="label">500</p>
      <h1>This side of the bridge is under repair</h1>
      <p class="body-text" style="margin: 0 auto 32px">
        Something broke on our end — but the journal continues. Try again in a moment.
      </p>
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap">
        <a
          href={getHomePermalink()}
          class="btn btn--primary btn--lg"
          data-track="500_nav"
          data-nav-target="home">Back to homepage</a
        >
        <a
          href={getPermalink('/editions')}
          class="btn btn--secondary btn--lg"
          data-track="500_nav"
          data-nav-target="editions">Browse editions</a
        >
      </div>
      <script is:inline>
        (function () {
          if (typeof window.gtag === 'function') {
            window.gtag('event', '500_page_view', {
              page_location: window.location.href,
              page_path: window.location.pathname,
            });
          }
          function init500Tracking() {
            document.querySelectorAll('[data-track="500_nav"]').forEach((el) => {
              if (el.dataset.tracked) return;
              el.dataset.tracked = 'true';
              el.addEventListener('click', () => {
                if (typeof window.gtag !== 'function') return;
                window.gtag('event', '500_nav_click', {
                  target: el.dataset.navTarget || '',
                });
              });
            });
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init500Tracking);
          } else {
            init500Tracking();
          }
          document.addEventListener('astro:page-load', init500Tracking);
        })();
      </script>
    </div>
  </section>
</FihLayout>
