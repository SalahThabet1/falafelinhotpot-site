---
interface Props {
  text: string;
  size?: 'sm' | 'md';
  variant?: 'crimson' | 'gold';
  class?: string;
}

const { text, size = 'md', variant = 'crimson', class: className = '' } = Astro.props;
---

<span
  class:list={[
    'seal',
    size === 'sm' && 'seal--small',
    variant === 'gold' && 'seal--gold',
    className,
  ]}
  aria-hidden="true"
>
  {text}
</span>

<style>
  .seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: 1.5px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
    transform: rotate(-6deg);
    opacity: 0.85;
    flex-shrink: 0;
  }
  .seal--small {
    width: 44px;
    height: 44px;
    font-size: 16px;
  }
  .seal--gold {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
</style>
