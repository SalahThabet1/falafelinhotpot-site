---
import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
  imageUrl?: string;
}

const { post, url, imageUrl } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.metadata?.title ?? post.title,
  description: post.metadata?.description ?? post.excerpt,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updateDate ?? post.publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Falafel',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Falafel in Hotpot',
    url: 'https://falafelinhotpot.com',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': String(url),
  },
  ...(imageUrl ? { image: [imageUrl] } : {}),
  ...(post.category ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.map((t) => t.title).join(', ') } : {}),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
