---
interface Props {
  id: string;
  title: string;
  views: string;
  index?: number;
}

const { id, title, views, index = 0 } = Astro.props;
const thumbUrl = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
const embedUrl = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
---

<article class="yt-card reveal" style={`--stagger: ${index}`}>
  <!-- 16:9 video area — padding-bottom trick: bulletproof cross-browser -->
  <div class="yt-card__ratio">
    <button
      class="yt-card__trigger"
      data-embed={embedUrl}
      aria-label={`Play: ${title}`}
    >
      <img
        src={thumbUrl}
        alt={title}
        class="yt-card__thumb"
        width="480"
        height="360"
        loading="lazy"
        decoding="async"
      />
      <span class="yt-card__play" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="68" height="48" focusable="false">
          <path
            d="M66.5 7.7c-.8-2.9-3-5.1-5.9-5.9C55.3 0 34 0 34 0S12.7 0 7.4 1.8C4.5 2.6 2.3 4.8 1.5 7.7 0 13.1 0 24 0 24s0 10.9 1.5 16.3c.8 2.9 3 5.1 5.9 5.9C12.7 48 34 48 34 48s21.3 0 26.6-1.8c2.9-.8 5.1-3 5.9-5.9C68 34.9 68 24 68 24s0-10.9-1.5-16.3z"
            fill="rgba(0,0,0,0.72)"
          />
          <path d="M45 24L27 14v20z" fill="#fff" />
        </svg>
      </span>
    </button>
  </div>

  <!-- Text content -->
  <div class="yt-card__body">
    <h3 class="yt-card__title">{title}</h3>
    <span class="yt-card__views">{views}</span>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.yt-card__trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const embedUrl = btn.dataset.embed;
      if (!embedUrl) return;

      const ratio = btn.closest('.yt-card__ratio') as HTMLElement;
      if (!ratio) return;

      const iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.title = btn.getAttribute('aria-label') ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';

      ratio.innerHTML = '';
      ratio.appendChild(iframe);
    }, { once: true });
  });
</script>

<style>
  .yt-card {
    background: #f4ebe1;
    border: 1px solid #e3d1b8;
    border-radius: 2px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .yt-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(74, 62, 48, 0.12);
    border-color: #d5c2a5;
  }

  /*
   * Bulletproof 16:9 container.
   * padding-bottom: 56.25% creates height = width × 9/16 from the element's
   * own width — no dependency on children or flex context whatsoever.
   */
  .yt-card__ratio {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background: #000;
    flex-shrink: 0;
  }

  /* Both the trigger button and the injected iframe fill the ratio box */
  .yt-card__trigger,
  .yt-card__ratio iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .yt-card__trigger {
    appearance: none;
    background: transparent;
    padding: 0;
    cursor: pointer;
    display: block;
  }

  .yt-card__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .yt-card:hover .yt-card__thumb {
    transform: scale(1.04);
  }

  .yt-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .yt-card__play svg {
    opacity: 0.92;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
    transition: transform 200ms ease, opacity 200ms ease;
  }

  .yt-card:hover .yt-card__play svg {
    opacity: 1;
    transform: scale(1.1);
  }

  .yt-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .yt-card__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: #2c2c2a;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .yt-card__views {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    color: #4a4a48;
    text-transform: uppercase;
    margin-top: auto;
  }
</style>
