---
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

interface FooterLink {
  text: string;
  href: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface SocialLink {
  label: string;
  href: string;
  icon: string;
}

export interface Props {
  columns?: FooterColumn[];
  socialLinks?: SocialLink[];
}

const {
  columns = [
    {
      title: 'Explore',
      links: [
        { text: 'Editions', href: getPermalink('/editions') },
        { text: 'Subscribe', href: getPermalink('/subscribe') },
      ],
    },
  ],
  socialLinks = [
    {
      label: 'Instagram',
      href: 'https://www.instagram.com/falafelinhotpott/',
      icon: 'simple-icons:instagram',
    },
    {
      label: 'TikTok',
      href: 'https://www.tiktok.com/@falafelinhotpot',
      icon: 'simple-icons:tiktok',
    },
    {
      label: 'YouTube',
      href: 'https://www.youtube.com/@falafelinhotpot',
      icon: 'simple-icons:youtube',
    },
    {
      label: 'WhatsApp',
      href: 'https://whatsapp.com/channel/0029Vb7mBywCxoAttPRlne0B',
      icon: 'simple-icons:whatsapp',
    },
    {
      label: 'LinkedIn',
      href: 'https://www.linkedin.com/company/falafel-in-hotpot/',
      icon: 'simple-icons:linkedin',
    },
    {
      label: 'Community',
      href: 'https://community.falafelinhotpot.com/',
      icon: 'tabler:users',
    },
  ],
} = Astro.props;
---

<footer class="footer" role="contentinfo">
  <div class="footer__inner">
    {
      columns.map((col) => (
        <div class="footer__col">
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.text}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="footer__col footer__col--connect">
      <h4>Connect</h4>
      <div class="footer__social" role="list" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              class="footer__social-link"
              role="listitem"
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              title={link.label}
              data-track="outbound_link_click"
              data-link-title={link.label}
            >
              <Icon name={link.icon} aria-hidden="true" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="footer__bottom">
    <span>© 2026 Falafel in Hotpot. All rights reserved.</span>
    <span>Arab world ⟷ China</span>
  </div>
</footer>

<script is:inline>
  (function () {
    function initFooterTracking() {
      document.querySelectorAll('.footer [data-track="outbound_link_click"]').forEach((el) => {
        if (el.dataset.tracked) return;
        el.dataset.tracked = 'true';
        el.addEventListener('click', () => {
          if (typeof window.gtag !== 'function') return;
          const href = el.getAttribute('href') || '';
          const title = el.dataset.linkTitle || '';
          window.gtag('event', 'outbound_link_click', {
            link_url: href,
            link_title: title,
          });
          if (
            href.includes('instagram.com') ||
            href.includes('youtube.com') ||
            href.includes('linkedin.com') ||
            href.includes('tiktok.com') ||
            href.includes('whatsapp.com')
          ) {
            window.gtag('event', 'social_link_click', {
              platform: title,
              link_url: href,
            });
          }
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterTracking);
    } else {
      initFooterTracking();
    }
    document.addEventListener('astro:page-load', initFooterTracking);
  })();
</script>

<style>
  .footer {
    background: var(--dark);
    color: rgba(251, 247, 237, 0.7);
    padding: 48px 0 32px;
  }
  .footer__inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }
  .footer__col h4 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--bg);
    margin: 0 0 16px;
  }
  .footer__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
  }
  .footer__col a {
    font-size: 14px;
    color: rgba(251, 247, 237, 0.6);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .footer__col a:hover {
    color: var(--gold);
  }
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid rgba(251, 247, 237, 0.15);
    border-radius: 0;
    background: rgba(251, 247, 237, 0.04);
    color: rgba(251, 247, 237, 0.65);
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }
  .footer__social-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .footer__social-link:hover {
    color: var(--gold);
    border-color: rgba(251, 247, 237, 0.3);
    background: rgba(251, 247, 237, 0.08);
    transform: translateY(-1px);
  }
  .footer__social-link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .footer__bottom {
    max-width: var(--container);
    margin: 32px auto 0;
    padding: 24px 24px 0;
    border-top: 1px solid rgba(251, 247, 237, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }
  @media (max-width: 820px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .footer__bottom {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
