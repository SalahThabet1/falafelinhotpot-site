{
  "name": "falafelinhotpot-site",
  "type": "module",
  "version": "1.0.0",
  "description": "Falafel in Hotpot — China-Arab cultural intelligence journal and Mandarin learning site.",
  "keywords": [
    "astro",
    "falafelinhotpot",
    "mandarin",
    "cultural-journal"
  ],
  "author": "Falafel in Hotpot",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalahThabet1/falafelinhotpot-site.git"
  },
  "homepage": "https://falafelinhotpot.com",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prebuild": "test -f public/mandarin-starterkit-course/index.html",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && astro check",
    "import:editions": "node scripts/import-activecampaign-editions.mjs",
    "sync:edu-images": "node scripts/import-activecampaign-editions.mjs --sync-edu-images",
    "sync:mandarin-landing": "npm run build --prefix ../../landing-main -- --base=/mandarin-starterkit-course/ && rm -rf public/mandarin-starterkit-course && mkdir -p public/mandarin-starterkit-course && cp -r ../../landing-main/dist/* public/mandarin-starterkit-course/"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.2.0",
    "@iconify-json/lucide": "^1.2.82",
    "@iconify-json/simple-icons": "^1.2.63",
    "@iconify-json/tabler": "^1.2.35",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.16.6",
    "astro-icon": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@tailwindcss/vite": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
