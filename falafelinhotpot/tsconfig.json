{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "~/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*", "lib/**/*", "api/**/*", "scripts/**/*.ts", "astro.config.mjs", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist"]
}
