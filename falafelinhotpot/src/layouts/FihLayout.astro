---
import '../styles/global.css';
import SEO from '~/components/common/SEO.astro';
import Nav from '~/components/fih/Nav.astro';
import Footer from '~/components/fih/Footer.astro';
import ParchmentGrain from '~/components/brand/ParchmentGrain.astro';
import AppToaster from '~/components/islands/AppToaster';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  hideFooter?: boolean;
}

const { metadata = {}, hideFooter = false } = Astro.props;
const title = metadata.title ?? 'Falafel in Hotpot';
const description =
  metadata.description ??
  'A cultural journal at the confluence of the Arab world and China. Language, food, poetry, business, history — explored as equals.';
const image = metadata.openGraph?.images?.[0]?.url;
const type = metadata.openGraph?.type === 'article' ? 'article' : 'website';
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <!-- Force light mode for public site — old dashboard theme may persist .dark in localStorage -->
    <script is:inline>document.documentElement.classList.remove('dark');localStorage.removeItem('theme');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Noto+Kufi+Arabic:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/open-design/landing.css" />
    <SEO title={title} description={description} image={image} type={type} />
    {metadata.canonical && <link rel="canonical" href={metadata.canonical} />}
    {metadata.robots?.index === false && <meta name="robots" content="noindex,follow" />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <ParchmentGrain />
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <AppToaster client:idle />

    <script>
      const initReveal = () => {
        const animated = document.querySelectorAll('.reveal, .sr-fade, .sr-left, .sr-scale');
        if (!animated.length) return;

        const reveal = (el) => {
          el.classList.add('visible', 'sr-visible');
        };

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || typeof IntersectionObserver === 'undefined') {
          animated.forEach(reveal);
          return;
        }

        // Content must never depend on JS/scroll to become visible (a fade-in
        // that never fires — blocked script, headless renderer, a tab that
        // never scrolls — should never ship a blank section). Anything
        // already on screen at load is revealed immediately; only content
        // below the fold is held back for the entrance transition, and even
        // that gets a hard timeout so it can never stay hidden for good.
        const viewportH = window.innerHeight;
        const pending = [];
        animated.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < viewportH && rect.bottom > 0) {
            reveal(el);
          } else {
            el.classList.add('reveal-pending');
            pending.push(el);
          }
        });
        if (!pending.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.remove('reveal-pending');
                reveal(entry.target);
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        pending.forEach((el) => observer.observe(el));

        window.setTimeout(() => {
          pending.forEach((el) => {
            observer.unobserve(el);
            el.classList.remove('reveal-pending');
            reveal(el);
          });
        }, 4000);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
