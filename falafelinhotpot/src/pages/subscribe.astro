---
import FihLayout from '~/layouts/FihLayout.astro';
import NewsletterForm from '~/components/islands/NewsletterForm';
import InkAtmosphere from '~/components/brand/InkAtmosphere.astro';

const metadata = {
  title: 'Subscribe',
  description:
    'Join our community to learn languages, cultures, history and business that connects the two dots.',
};

const bullets = [
  'The culture',
  'The language',
  'The business dynamics',
  'The conversations nobody else is having',
];
---

<FihLayout metadata={metadata}>
  <section class="section subscribe-page">
    <InkAtmosphere washes={2} opacity={0.35} />
    <div class="container subscribe-page__inner">
      <div class="subscribe-page__intro reveal">
        <span class="label">Newsletter</span>
        <h1>Two civilisations. One intersection.</h1>
        <p class="body-text">
          Join our community to learn languages, cultures, history and business that connects the
          two dots.
        </p>
        <p class="subscribe-page__lede">
          Subscribe to our free weekly newsletter and get one letter a week on what's really
          happening at the intersection of China and the Arab world:
        </p>
        <ul class="subscribe-benefits">
          {
            bullets.map((item) => (
              <li>
                <span class="subscribe-benefits__dot" aria-hidden="true">
                  •
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <a class="subscribe-page__archive-link" href="/editions">
          Browse past issues <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="subscribe-card reveal reveal--delay-2">
        <div class="subscribe-card__header">
          <h2 class="subscribe-card__title">Newsletter</h2>
          <p class="subscribe-card__description">We'll never spam you or sell your data.</p>
        </div>
        <NewsletterForm client:visible variant="editorial" />
      </div>
    </div>
  </section>
</FihLayout>

<style>
  .subscribe-page {
    position: relative;
    /* Nav is position:fixed (out of flow), so the viewport-fill math has to
       add its height back as padding, not just subtract it from min-height —
       otherwise this section starts at y:0 underneath the fixed nav instead
       of below it, and align-items: center hides the top of the content
       behind the nav bar. */
    min-height: 100dvh;
    padding-top: var(--nav-height, 60px);
    display: flex;
    align-items: center;
  }
  .subscribe-page::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/texture.webp');
    background-repeat: repeat;
    opacity: 0.4;
    pointer-events: none;
  }
  .subscribe-page__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    padding: 0 var(--container-x);
  }
  /* Global h1 defaults to --text-3xl (editions-hero scale); this page's
     two-column layout needs a smaller heading so it doesn't overpower the
     form beside it. */
  .subscribe-page__intro h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: #2c2c2a;
    mix-blend-mode: multiply;
    text-wrap: balance;
  }
  .subscribe-page__lede {
    margin: 20px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--fg-2);
    max-width: 60ch;
  }
  .subscribe-benefits {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .subscribe-benefits li {
    display: flex;
    align-items: baseline;
    font-size: 15px;
    color: var(--fg-2);
  }
  .subscribe-benefits__dot {
    flex-shrink: 0;
    margin-right: 1rem;
    font-size: 1.125rem;
    line-height: 1;
    color: var(--color-cinnabar, #9b1b15);
  }
  .subscribe-page__archive-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 28px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-cinnabar, #9b1b15);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 180ms ease;
  }
  .subscribe-page__archive-link:hover {
    border-color: var(--color-cinnabar, #9b1b15);
  }

  /* ── Tactile Editorial card ─────────────────────── */
  .subscribe-card {
    position: relative;
    background: #f4ebe1;
    border: 1px solid #e3d1b8;
    border-radius: 2px;
    padding: 2.5rem;
  }
  @media (min-width: 1024px) {
    .subscribe-card {
      padding: 3rem;
    }
  }
  .subscribe-card__header {
    margin-bottom: 1.75rem;
  }
  .subscribe-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: #2c2c2a;
    line-height: 1.3;
  }
  .subscribe-card__description {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: #4a4a48;
  }

  @media (max-width: 820px) {
    .subscribe-page__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
