---
import FihLayout from '~/layouts/FihLayout.astro';
import VideoCard from '~/components/fih/VideoCard.astro';
import NewsletterForm from '~/components/islands/NewsletterForm';

const metadata = {
  title: 'Falafel in Hotpot — A bridge between worlds',
  description:
    'A cultural journal at the confluence of the Arab world and China. Language, food, poetry, business, history — explored as equals.',
};

// Sorted by views desc — update periodically
const videos = [
  {
    id: '7jnaLsLiFOI',
    title: "Arabic speakers are built for Chinese. Here's the proof",
    views: '133K views',
  },
  {
    id: 'ESPibG7cHkY',
    title: '5 Ways Arabs and Chinese Are More Similar Than You Think',
    views: '36K views',
  },
  {
    id: 'XfaS25MzHEg',
    title: 'Growing up Chinese and Arab is literally the same thing',
    views: '20K views',
  },
];
---

<FihLayout metadata={metadata}>
  <!-- ④ COURSE CALLOUT ────────────────────────────────────────── -->
  <section class="course-section">
    <div class="container">
      <div class="course-card">
        <div class="course-card__media">
          <img
            src="/course-chinese-foundation.jpg"
            alt="The Mandarin Starter Kit"
            class="course-card__img"
            width="1600"
            height="893"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="course-card__content">
          <span class="course-badge">Mandarin Starter Kit</span>

          <h3 class="course-card__h3">Chinese that finally makes sense.</h3>

          <p class="course-card__body">
            Learn the Mandarin people actually use, with pronunciation, pinyin, everyday phrases,
            worksheets, and cultural context explained clearly for Arabic speakers. Not a course you
            finish. A resource you keep.
          </p>

          <a href="/mandarin-starterkit-course/#pricing" class="btn btn--primary">
            Choose your spot →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ① HERO ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__visual">
        <img
          src="/images/falafel.jpeg"
          alt="Falafel — founder of Falafel in Hotpot"
          class="hero__img"
          width="1200"
          height="1600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <!-- Text RIGHT -->
      <div class="hero__copy reveal">
        <h1 class="hero__h1">
          <span class="hero__greeting-ar" lang="ar">أهلاً</span>
          <span class="hero__greeting-sep"> &amp; </span>
          <span class="hero__greeting-zh" lang="zh">你好</span>
        </h1>
        <p class="hero__intro">
          I'm Falafel — a polyglot, content creator, and entrepreneur bridging China and the Arab
          world.
        </p>
        <p class="hero__tagline">
          I built Falafel in Hotpot — the only China-Arab cultural intelligence brand in the Arab
          world. We teach Mandarin to Arabs, help Gulf businesses navigate China, and create content
          that connects two civilisations most people never thought had anything in common.
        </p>
        <div class="hero__ctas">
          <a href="/editions" class="btn btn--primary">Read the latest →</a>
          <a href="#subscribe" class="btn btn--ghost">Subscribe ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ② NEWSLETTER ────────────────────────────────────────────── -->
  <section id="subscribe" class="nl-section">
    <div class="nl-container">
      <div class="nl-box">
        <div class="nl-cols">
          <!-- LEFT 40%: Brand title + social proof (Ali Abdaal pattern) -->
          <div class="nl-col nl-col--left">
            <div class="nl-brand">
              <p class="nl-brand__sub">Subscribe to</p>
              <p class="nl-brand__name">Falafel<br />in Hotpot</p>
            </div>
            <p class="nl-social-text">
              Join a growing community of <strong>10,000+ readers</strong><br />
              bridging 阿拉伯 × 中国.
            </p>
          </div>

          <!-- RIGHT 60%: Description + inline form + disclaimer -->
          <div class="nl-col nl-col--right">
            <p class="nl-desc">
              Each week, one story from the intersection of the Arab world and China — language,
              food, business, history. One tradition is not the exotic other. It's free to join, and
              always will be.
            </p>

            <NewsletterForm client:visible variant="inline" />

            <p class="nl-disclaimer">
              By subscribing you'll receive weekly dispatches from the bridge. No spam. Unsubscribe
              anytime.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ③ BRAND MANIFESTO — Magazine Split ─────────────────────── -->
  <section class="manifesto-section">
    <img
      src="/brand/logo-light-no-text.png"
      alt=""
      class="manifesto-ghost-logo"
      width="907"
      height="907"
      loading="lazy"
      decoding="async"
      aria-hidden="true"
    />
    <div class="manifesto-inner">
      <div class="manifesto-grid">
        <div class="manifesto-copy">
          <span class="eyebrow">Where East Meets East</span>
          <h2 class="manifesto-headline">Falafel<br />in Hotpot.</h2>
          <p class="manifesto-body manifesto-body--lead">
            Falafel in Hotpot is a China-Arab cultural intelligence brand based in Riyadh. We sit at
            the intersection of two of the world's oldest civilisations, and we make that
            intersection useful.
          </p>
          <div class="manifesto-rule" aria-hidden="true"></div>
          <p class="manifesto-body manifesto-body--secondary">
            Whether you're a Gulf business navigating a Chinese partnership, a professional learning
            Mandarin for the first time, or simply someone curious about what these two worlds have
            in common, we built this for you. Language, culture, and connection, all in one place.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑤ VIDEO GRID ────────────────────────────────────────────── -->
  <section class="videos-section">
    <div class="container">
      <div class="section-heading reveal">
        <span class="eyebrow">On YouTube</span>
        <h2 class="videos-section__h2">Watch our most popular videos</h2>
      </div>

      <ul class="video-grid" role="list">
        {
          videos.map((v, i) => (
            <li class="video-grid__item">
              <VideoCard id={v.id} title={v.title} views={v.views} index={i} />
            </li>
          ))
        }
      </ul>

      <div class="videos-section__footer reveal" style="--stagger: 3">
        <a
          href="https://www.youtube.com/@falafelinhotpot"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost"
        >
          See all videos on YouTube →
        </a>
      </div>
    </div>
  </section>
</FihLayout>

<style>
  /* ── Shared animations ───────────────────────────────────────── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Visible by default — JS only hides below-fold sections (via
     .reveal-pending, added just before they're observed) to animate them in.
     If JS never runs, nothing is ever hidden in the first place. */
  .reveal {
    opacity: 1;
  }
  .reveal.reveal-pending {
    opacity: 0;
  }

  .reveal.visible {
    animation: fadeInUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--stagger, 0) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal.reveal-pending {
      opacity: 1;
    }
    .reveal.visible {
      animation: none;
    }
  }

  /* ── Shared tokens ───────────────────────────────────────────── */
  .eyebrow {
    display: block;
    margin-bottom: 0.75rem;
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-cinnabar, #9b1b15);
    mix-blend-mode: multiply;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
  }

  .btn--primary {
    background: var(--color-cinnabar, #9b1b15);
    color: var(--color-parchment, #fbf7ed);
    border-color: var(--color-cinnabar, #9b1b15);
  }

  .btn--primary:hover {
    background: #7a1510;
    border-color: #7a1510;
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-ink, #2c2c2a);
    border-color: rgba(44, 44, 42, 0.3);
  }

  .btn--ghost:hover {
    border-color: var(--color-cinnabar, #9b1b15);
    color: var(--color-cinnabar, #9b1b15);
  }

  /* ── ① Hero ─────────────────────────────────────────────────── */
  .hero {
    background-color: var(--color-clay, #eddcc6);
    padding: clamp(7rem, 10vw, 9rem) 0 clamp(4rem, 7vw, 6rem);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    /* image LEFT, text RIGHT — matching aliabdaal.com */
    grid-template-columns: 42fr 58fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  /* Image column — full portrait visible, no crop */
  .hero__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: min(100%, 28rem);
    margin-inline: auto;
    background: var(--color-parchment, #fbf7ed);
  }

  .hero__img {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(72vh, 42rem);
    object-fit: contain;
    object-position: center;
    mix-blend-mode: normal;
  }

  /* Text column */
  .hero__copy {
    display: flex;
    flex-direction: column;
  }

  .hero__h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(3rem, 6vw, 5.2rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--color-ink, #2c2c2a);
    mix-blend-mode: multiply;
  }

  /* Arabic half — Cairo, right-to-left shaping but inline LTR flow */
  .hero__greeting-ar {
    font-family: 'Cairo', sans-serif;
    font-weight: 700;
    unicode-bidi: embed;
    direction: rtl;
  }

  .hero__greeting-sep {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-cinnabar, #9b1b15);
    margin: 0 0.15em;
  }

  /* Chinese half — Noto Sans SC */
  .hero__greeting-zh {
    font-family: 'Noto Sans SC', sans-serif;
    font-weight: 700;
  }

  /* "I'm Falafel" — prominent single line */
  .hero__intro {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-ink, #2c2c2a);
    mix-blend-mode: multiply;
  }

  .hero__tagline {
    margin: 0 0 2.25rem;
    max-width: 54ch;
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.8;
    color: var(--color-text-muted, #4f4744);
    mix-blend-mode: multiply;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* ── ② Newsletter (Ali Abdaal 40/60 pattern) ────────────────── */
  .nl-section {
    background-color: var(--color-parchment, #fbf7ed);
    padding: clamp(3.5rem, 6vw, 5rem) 0;
  }

  .nl-container {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* The cta-box — sharp editorial panel */
  .nl-box {
    background-color: #eedbb6;
    border: 1px solid #e3d1b8;
    border-radius: 0;
    overflow: hidden;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3.5rem);
  }

  /* Editorial split-card: left anchor, right action zone */
  .nl-cols {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .nl-col--left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  /* LEFT — brand stacked title (Ali's life-notes-plane) */
  .nl-brand {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .nl-brand__sub {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: #2c2c2a;
    line-height: 1.1;
  }

  .nl-brand__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    color: #9b1b15;
    line-height: 1.05;
  }

  .nl-social-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #4a4a48;
  }

  /* RIGHT — description + form + disclaimer */
  .nl-col--right {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    justify-content: center;
    min-width: 0;
  }

  .nl-desc {
    margin: 0;
    max-width: 44rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
    color: #2c2c2a;
    text-wrap: pretty;
  }

  /* Inline form row: [input ──────────────────] [Submit] */
  #dispatch-form {
    width: min(100%, 32rem);
    max-width: 100%;
    min-width: 0;
    min-height: 2.875rem;
    overflow: hidden;
  }

  #dispatch-form input {
    flex: 1 1 0%;
    width: 0;
    height: 2.875rem;
    min-width: 0;
    background-color: #f4ebe1;
    border-radius: 0;
    color: #2c2c2a;
    font-size: 0.95rem;
    line-height: 1.2;
    padding-block: 0;
    padding-inline: 0.95rem;
  }

  #dispatch-form input::placeholder {
    color: rgba(44, 44, 42, 0.72);
  }

  #dispatch-form button {
    flex: 0 0 auto;
    height: 2.875rem;
    min-width: max-content;
    background-color: #9b1b15 !important;
    border: 1px solid #9b1b15;
    border-radius: 0;
    color: #fbf7ed !important;
    font-size: 0.9rem;
    line-height: 1;
    padding-block: 0;
    padding-inline: clamp(1.25rem, 2vw, 1.75rem);
    white-space: nowrap;
  }

  #dispatch-form button:hover {
    background-color: #7a1510 !important;
    border-color: #7a1510;
  }

  .nl-form__status {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: #4a4a48;
  }

  .nl-disclaimer {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #4a4a48;
  }

  /* Keep the editorial split until the card genuinely needs to stack. */
  @media (min-width: 700px) {
    .nl-cols {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
      column-gap: clamp(2rem, 4vw, 4rem);
    }
  }

  /* ── ③ Brand Manifesto — editorial panel with ghost mark ─────── */
  .manifesto-section {
    position: relative;
    overflow: hidden;
    background-color: var(--color-clay, #eddcc6);
    border-top: 1px solid rgba(44, 44, 42, 0.12);
    border-bottom: 1px solid rgba(44, 44, 42, 0.12);
    padding: clamp(5rem, 9vw, 7.5rem) 0;
  }

  .manifesto-ghost-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    height: min(78vh, 34rem);
    max-width: 110vw;
    opacity: 0.12;
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
    z-index: 0;
    object-fit: contain;
  }

  .manifesto-inner {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  .manifesto-copy {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
    max-width: 40rem;
    text-align: left;
  }

  .manifesto-copy .eyebrow {
    margin-bottom: 1rem;
  }

  .manifesto-headline {
    margin: 0 0 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.25rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--color-ink, #2c2c2a);
    mix-blend-mode: multiply;
    text-wrap: balance;
  }

  .manifesto-body {
    margin: 0;
    text-align: left;
    max-width: 38rem;
  }

  .manifesto-body--lead {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.55;
    font-weight: 500;
    color: var(--color-ink, #2c2c2a);
    mix-blend-mode: multiply;
    text-wrap: pretty;
  }

  .manifesto-rule {
    width: 3.5rem;
    height: 1px;
    background: rgba(155, 27, 21, 0.4);
    margin: 1.5rem 0;
  }

  .manifesto-body--secondary {
    font-size: clamp(0.975rem, 1.15vw, 1.0625rem);
    line-height: 1.8;
    color: var(--color-text-muted, #4f4744);
    mix-blend-mode: multiply;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .manifesto-ghost-logo {
      left: auto;
      right: clamp(-3rem, -2vw, -1rem);
      height: min(88vh, 46rem);
      max-width: min(72vw, 52rem);
      transform: translateY(-50%);
    }

    .manifesto-copy {
      max-width: min(36rem, 52%);
    }
  }

  /* ── ④ Course ────────────────────────────────────────────────── */
  .course-section {
    background-color: var(--color-parchment, #fbf7ed);
    padding: clamp(3.5rem, 6vw, 5rem) 0;
  }

  .course-card {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-card, #fdf9f1);
    position: relative;
    overflow: hidden;
  }

  .course-card__media {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #3d1714;
    aspect-ratio: 1600 / 893;
  }

  .course-card__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .course-card__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    position: relative;
    z-index: 2;
  }

  .course-badge {
    display: inline-block;
    margin-bottom: 0.875rem;
    padding: 0.25rem 0.625rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-cinnabar, #9b1b15);
    border: 1px solid var(--color-cinnabar, #9b1b15);
    width: fit-content;
  }

  .course-card__h3 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--color-ink, #2c2c2a);
    mix-blend-mode: multiply;
  }

  .course-card__body {
    margin: 0 0 1.75rem;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted, #4f4744);
    mix-blend-mode: multiply;
  }

  @media (min-width: 769px) {
    .course-card {
      grid-template-columns: minmax(0, 58%) minmax(0, 42%);
      align-items: center;
    }
  }

  /* ── ⑤ Video Grid ────────────────────────────────────────────── */
  .videos-section {
    background-color: var(--color-parchment, #fbf7ed);
    position: relative;
    padding: clamp(3.5rem, 6vw, 5rem) 0;
  }

  .videos-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/texture.webp');
    background-repeat: repeat;
    opacity: 0.15;
    pointer-events: none;
  }

  .videos-section .container {
    position: relative;
    z-index: 1;
  }

  .section-heading {
    margin-bottom: 2.5rem;
  }

  .videos-section__h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-ink, #2c2c2a);
    mix-blend-mode: multiply;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
  }

  .video-grid__item {
    display: flex;
    flex-direction: column;
  }

  .videos-section__footer {
    display: flex;
    justify-content: center;
  }

  /* ── Mobile ─────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
      max-width: min(100%, 20rem);
    }

    .hero__img {
      max-height: min(58vh, 24rem);
    }

    .course-card {
      grid-template-columns: 1fr;
    }

    .video-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 480px) and (max-width: 768px) {
    .video-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
