---
/**
 * SEO - Comprehensive meta tags and structured data for search engines
 *
 * @description
 * Handles all SEO-related meta tags including Open Graph, Twitter Cards,
 * and JSON-LD structured data. Automatically generates canonical URLs,
 * breadcrumbs, and organization schema from site config.
 *
 * The page <title> is resolved here: site name is appended once, unless the
 * title already contains it or `ignoreTitleTemplate` is set (callers may
 * hand in a fully-formatted title, e.g. edition `metadata.title`).
 *
 * @example
 * ```astro
 * <SEO
 *   title="Features"
 *   description="Explore all the powerful features of our platform."
 * />
 * ```
 */
import { siteConfig } from '@/config/site';

interface Props {
  /** Page title (site name is appended once unless already present) */
  title: string;
  /** Page description for meta tags */
  description: string;
  /** Custom Open Graph image URL (defaults to site ogImage) */
  image?: string;
  /** Canonical URL; defaults to the current route path */
  canonical?: string;
  /** Emit the title verbatim, without the site-name template */
  ignoreTitleTemplate?: boolean;
  /** Content type for Open Graph */
  type?: 'website' | 'article';
  /** Article tags/keywords */
  tags?: string[];
}

const {
  title,
  description,
  image,
  canonical,
  ignoreTitleTemplate = false,
  type = 'website',
  tags = [],
} = Astro.props;

const canonicalHref = canonical || new URL(Astro.url.pathname, siteConfig.url).href;
const fullTitle =
  ignoreTitleTemplate || title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
const imageUrl = image || siteConfig.ogImage;
const ogImage = imageUrl ? new URL(imageUrl, siteConfig.url).href : undefined;

// JSON-LD Structured Data
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.description,
  url: siteConfig.url,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  url: siteConfig.url,
  logo: new URL(siteConfig.logo, siteConfig.url).href,
  sameAs: [siteConfig.social.twitter, siteConfig.social.github, siteConfig.social.discord].filter(
    Boolean
  ),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteConfig.url,
    },
    ...(Astro.url.pathname !== '/'
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: title,
            item: canonicalHref,
          },
        ]
      : []),
  ],
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalHref} />

<!-- Sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.name} />
{ogImage && <meta property="og:image" content={ogImage} />}

<!-- Twitter -->
<meta property="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta property="twitter:url" content={canonicalHref} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
{ogImage && <meta property="twitter:image" content={ogImage} />}

<!-- JSON-LD Structured Data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
