---
import FihLayout from '~/layouts/FihLayout.astro';
import InkAtmosphere from '~/components/brand/InkAtmosphere.astro';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

interface Props {
  /** HTTP status code, shown as the label and used as the GA4 event prefix */
  code: number;
  /** Page title for <head> */
  title: string;
  /** Headline shown above the body copy */
  heading: string;
  /** Body copy under the headline */
  body: string;
}

const { code, title, heading, body } = Astro.props;
---

<FihLayout metadata={{ title }}>
  <section
    class="section"
    style="min-height: 60dvh; display: flex; align-items: center; position: relative"
  >
    <InkAtmosphere washes={1} opacity={0.2} />
    <div class="container" style="text-align: center; position: relative; z-index: 2">
      <p class="label">{code}</p>
      <h1>{heading}</h1>
      <p class="body-text" style="margin: 0 auto 32px">
        {body}
      </p>
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap">
        <a
          href={getHomePermalink()}
          class="btn btn--primary btn--lg"
          data-track="error_nav"
          data-nav-target="home">Back to homepage</a
        >
        <a
          href={getPermalink('/editions')}
          class="btn btn--secondary btn--lg"
          data-track="error_nav"
          data-nav-target="editions">Browse editions</a
        >
      </div>
      <script is:inline define:vars={{ code }}>
        (function () {
          if (typeof window.gtag === 'function') {
            window.gtag('event', code + '_page_view', {
              page_location: window.location.href,
              page_path: window.location.pathname,
            });
          }
          function initErrorTracking() {
            document.querySelectorAll('[data-track="error_nav"]').forEach((el) => {
              if (el.dataset.tracked) return;
              el.dataset.tracked = 'true';
              el.addEventListener('click', () => {
                if (typeof window.gtag !== 'function') return;
                window.gtag('event', code + '_nav_click', {
                  target: el.dataset.navTarget || '',
                });
              });
            });
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initErrorTracking);
          } else {
            initErrorTracking();
          }
          document.addEventListener('astro:page-load', initErrorTracking);
        })();
      </script>
    </div>
  </section>
</FihLayout>
