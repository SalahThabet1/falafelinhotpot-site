---
import { Icon } from 'astro-icon/components';
import { getShareNetworks } from '~/lib/social-share';

export interface Props {
  text: string;
  url: string | URL;
  variant?: 'default' | 'article';
}

const { text, url, variant = 'default' } = Astro.props;
const isArticle = variant === 'article';
const shareUrl = String(url);
const networks = getShareNetworks(shareUrl, text);
---

<div class:list={['social-share', { 'social-share--article': isArticle }]}>
  <span class="social-share__label">Share</span>
  <div class="social-share__actions" role="group" aria-label="Share this edition">
    {
      networks.map((network) =>
        network.copyLink ? (
          <button
            type="button"
            class="social-share__button"
            title={network.label}
            aria-label={network.label}
            data-share-copy
            data-share-url={shareUrl}
          >
            <Icon name={network.icon} aria-hidden="true" />
          </button>
        ) : (
          <a
            href={network.href}
            class="social-share__button"
            title={network.label}
            aria-label={network.label}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name={network.icon} aria-hidden="true" />
          </a>
        )
      )
    }
  </div>
  <p class="social-share__hint" aria-live="polite" hidden data-share-feedback>
    Link copied — paste it in your story or post.
  </p>
</div>

<script>
  function initShareCopy() {
    document.querySelectorAll('[data-share-copy]').forEach((button) => {
      if (button instanceof HTMLButtonElement && button.dataset.shareBound === 'true') return;
      if (!(button instanceof HTMLButtonElement)) return;

      button.dataset.shareBound = 'true';
      button.addEventListener('click', async () => {
        const url = button.dataset.shareUrl;
        if (!url) return;

        const originalLabel = button.getAttribute('aria-label') ?? 'Copy link';
        const feedback = button.closest('.social-share')?.querySelector('[data-share-feedback]');

        try {
          await navigator.clipboard.writeText(url);
          button.setAttribute('aria-label', 'Link copied');
          if (feedback instanceof HTMLElement) {
            feedback.hidden = false;
            window.setTimeout(() => {
              feedback.hidden = true;
            }, 2400);
          }
        } catch {
          button.setAttribute('aria-label', 'Could not copy link');
        }

        window.setTimeout(() => {
          button.setAttribute('aria-label', originalLabel);
        }, 2400);
      });
    });
  }

  initShareCopy();
  document.addEventListener('astro:page-load', initShareCopy);
</script>

<style>
  .social-share {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .social-share--article {
    flex: 0 0 auto;
    align-items: flex-end;
    width: auto;
    max-width: 100%;
  }

  .social-share__label {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5c534f;
  }

  .social-share__actions {
    display: grid;
    grid-template-columns: repeat(5, 2.25rem);
    align-items: center;
    justify-items: center;
    justify-content: end;
    gap: 0.375rem;
    width: auto;
  }

  @media (max-width: 560px) {
    .social-share--article {
      margin-left: auto;
    }

    .social-share__actions {
      gap: 0.25rem;
    }
  }

  .social-share__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border, #d5c2a5);
    border-radius: 0;
    background: var(--color-xuan-50, #fbf9f6);
    color: var(--color-ink-light);
    cursor: pointer;
    text-decoration: none;
    transition:
      color 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .social-share__button :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .social-share__button:hover {
    color: var(--color-accent, #c0392b);
    border-color: #d8d8d8;
    background: #faf9f7;
    transform: translateY(-1px);
  }

  .social-share__button:focus-visible {
    outline: 2px solid var(--color-gold, #c39a3c);
    outline-offset: 2px;
  }

  .social-share__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: #5c534f;
  }
</style>
