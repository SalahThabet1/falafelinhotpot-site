---
import PostTags from '~/components/editions/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<footer class="article-footer">
  <PostTags tags={post.tags} />
  <SocialShare url={url} text={post.title} variant="article" />
</footer>

<style>
  .article-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 1.25rem 2rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #eaeaea;
  }

  @media (max-width: 560px) {
    .article-footer {
      grid-template-columns: 1fr;
    }

    .article-footer :global(.social-share--article) {
      justify-self: end;
    }
  }
</style>
