---
export interface Props {
  src: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="edition-hero">
  <img
    class="edition-hero__image"
    src={src}
    alt={alt}
    width="1400"
    height="600"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
</figure>

<style>
  .edition-hero {
    position: relative;
    margin: 0;
    width: min(100%, 112rem);
    height: clamp(24rem, 68vh, 44rem);
    margin-inline: auto;
    overflow: hidden;
    background: var(--color-parchment, #fbf7ed);
  }

  .edition-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        to bottom,
        rgba(251, 247, 237, 0) 0%,
        rgba(251, 247, 237, 0.08) 48%,
        rgba(251, 247, 237, 0.52) 76%,
        var(--color-parchment, #fbf7ed) 100%
      ),
      linear-gradient(to top, rgba(44, 44, 42, 0.2) 0%, rgba(44, 44, 42, 0) 46%);
  }

  .edition-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    background: #f8f5ef;
  }

  @media (max-width: 640px) {
    .edition-hero {
      height: auto;
    }

    .edition-hero__image {
      height: auto;
      object-fit: contain;
    }
  }
</style>
