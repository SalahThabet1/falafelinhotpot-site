---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata | string;
  alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="edition-figure">
  {
    typeof src === 'string' ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" width="720" height="405" />
    ) : (
      <Image src={src} alt={alt} loading="lazy" decoding="async" widths={[480, 720, 1080]} />
    )
  }
</figure>

<style>
  .edition-figure {
    margin: 2.5rem 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    overflow: hidden;
  }
  .edition-figure img {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    vertical-align: middle;
  }
</style>
