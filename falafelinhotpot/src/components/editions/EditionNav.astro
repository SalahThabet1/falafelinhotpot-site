---
import { Icon } from 'astro-icon/components';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
import type { Post } from '~/types';

export interface Props {
  prevPost?: Post;
  nextPost?: Post;
  currentIndex: number;
  totalPosts: number;
  currentSeries?: string;
}

const { prevPost, nextPost, currentIndex, totalPosts, currentSeries } = Astro.props;

const prevHref = prevPost ? getPermalink(prevPost.permalink) : undefined;
const nextHref = nextPost ? getPermalink(nextPost.permalink) : undefined;
const pageNumber = currentIndex + 1;
const editionsHref = getBlogPermalink();

const SERIES_LABELS: Record<string, string> = { cultural: 'Cultural', learn: 'Learn' };

function seriesLabel(series?: string): string {
  return SERIES_LABELS[series ?? ''] ?? '';
}

const prevSeriesLabel =
  prevPost && currentSeries && prevPost.series !== currentSeries
    ? seriesLabel(prevPost.series)
    : undefined;
const nextSeriesLabel =
  nextPost && currentSeries && nextPost.series !== currentSeries
    ? seriesLabel(nextPost.series)
    : undefined;
---

<nav class="edition-nav" aria-label="Edition navigation">
  <div class="edition-nav__inner">
    <div class="edition-nav__row">
      {
        prevHref ? (
          <a href={prevHref} rel="prev" class="edition-nav__card edition-nav__card--prev">
            <span class="edition-nav__card-label">
              <Icon name="lucide:arrow-left" aria-hidden="true" />
              Previous
            </span>
            {prevSeriesLabel && <span class="edition-nav__series">{prevSeriesLabel}</span>}
            <span class="edition-nav__card-title">{prevPost?.title}</span>
          </a>
        ) : (
          <div class="edition-nav__spacer" aria-hidden="true" />
        )
      }

      <p class="edition-nav__position">
        Page {pageNumber} of {totalPosts}
      </p>

      {
        nextHref ? (
          <a href={nextHref} rel="next" class="edition-nav__card edition-nav__card--next">
            <span class="edition-nav__card-label">
              Next
              <Icon name="lucide:arrow-right" aria-hidden="true" />
            </span>
            {nextSeriesLabel && <span class="edition-nav__series">{nextSeriesLabel}</span>}
            <span class="edition-nav__card-title">{nextPost?.title}</span>
          </a>
        ) : (
          <div class="edition-nav__spacer" aria-hidden="true" />
        )
      }
    </div>

    <a href={editionsHref} class="edition-nav__back">
      <Icon name="lucide:arrow-left" aria-hidden="true" />
      Back to Editions
    </a>
  </div>
</nav>

<style>
  .edition-nav {
    border-top: 1px solid var(--color-border, #d5c2a5);
    border-bottom: 1px solid var(--color-border, #d5c2a5);
    background: transparent;
  }

  .edition-nav__inner {
    max-width: 45rem;
    margin: 0 auto;
    padding: 1.75rem var(--container-x, 1.25rem);
  }

  .edition-nav__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .edition-nav__row {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: start;
      gap: 1.25rem;
    }
  }

  .edition-nav__position {
    margin: 0;
    padding: 0.75rem 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    color: #8a817c;
  }

  @media (min-width: 768px) {
    .edition-nav__position {
      padding-top: 1rem;
    }
  }

  .edition-nav__card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-height: 5.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(213, 194, 165, 0.8);
    border-radius: 0;
    background: var(--color-xuan-50, #fbf9f6);
    text-decoration: none;
    position: relative;
    transition:
      border-color 180ms ease,
      transform 180ms ease;
  }

  .edition-nav__card::before {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid rgba(213, 194, 165, 0.3);
    pointer-events: none;
  }

  .edition-nav__card:hover {
    border-color: rgba(213, 194, 165, 1);
    transform: translateY(-1px);
  }

  .edition-nav__card:focus-visible {
    outline: 2px solid var(--color-gold, #c39a3c);
    outline-offset: 3px;
  }

  .edition-nav__card--prev {
    text-align: left;
  }

  .edition-nav__card--next {
    text-align: right;
  }

  .edition-nav__card-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent, #c0392b);
  }

  .edition-nav__card-label :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .edition-nav__card--next .edition-nav__card-label {
    justify-content: flex-end;
  }

  .edition-nav__series {
    align-self: flex-start;
    padding: 0.125rem 0.5rem;
    border-radius: 0;
    background: rgba(195, 154, 60, 0.16);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5c534f;
  }

  .edition-nav__card--next .edition-nav__series {
    align-self: flex-end;
  }

  .edition-nav__card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.35;
    color: #1c1c1c;
  }

  .edition-nav__spacer {
    display: none;
  }

  @media (min-width: 768px) {
    .edition-nav__spacer {
      display: block;
    }
  }

  .edition-nav__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: #5c534f;
    transition: color 180ms ease;
  }

  .edition-nav__back :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .edition-nav__back:hover {
    color: var(--color-accent, #c0392b);
  }

  .edition-nav__back:focus-visible {
    outline: 2px solid var(--color-gold, #c39a3c);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
