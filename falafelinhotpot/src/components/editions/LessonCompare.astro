---
export interface Row {
  zh: string;
  py: string;
  en: string;
  note?: string;
}

export interface Props {
  title?: string;
  rows: Row[];
}

const { title, rows } = Astro.props;
---

<section class="lesson-compare">
  {title && <p class="lesson-compare__title">{title}</p>}
  <ul class="lesson-compare__list">
    {
      rows.map((row) => (
        <li class="lesson-compare__row">
          <span class="lesson-compare__zh zh">{row.zh}</span>
          <div class="lesson-compare__text">
            <span class="lesson-compare__py">{row.py}</span>
            <span class="lesson-compare__en">{row.en}</span>
            {row.note && <span class="lesson-compare__note">{row.note}</span>}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .lesson-compare {
    margin: 2rem 0;
    padding: 1.25rem 1.375rem;
    background: color-mix(in srgb, var(--color-gold) 8%, var(--color-surface));
    border: 1px solid var(--color-border);
  }

  .lesson-compare__title {
    margin: 0 0 1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lesson-compare__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lesson-compare__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.875rem;
    align-items: start;
    padding: 0.75rem 0;
    border-top: 1px solid var(--color-border);
  }

  .lesson-compare__row:first-child {
    border-top: none;
    padding-top: 0;
  }

  .lesson-compare__zh {
    font-family: var(--font-chinese);
    font-size: 1.375rem;
    color: var(--color-accent);
    line-height: 1.2;
  }

  .lesson-compare__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .lesson-compare__py {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  .lesson-compare__en {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .lesson-compare__note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
