---
interface Props {
  variant?: 'simple' | 'wave' | 'double-wave';
}

const { variant = 'simple' } = Astro.props;

const paths: Record<string, string> = {
  simple: 'M0 12 H120 Q140 2,160 12 H280',
  wave: 'M0 12 H100 Q120 2,140 12 H180 Q200 22,220 12 H280',
  'double-wave': 'M0 12 H80 Q100 2,120 12 H160 Q180 22,200 12 H280',
};
const d = paths[variant];
---

<div class="ink-divider" aria-hidden="true">
  <svg viewBox="0 0 280 24" fill="none">
    <path d={d} stroke="#C39A3C" stroke-width="0.75" opacity="0.5"></path>
    <path d={d} stroke="#C39A3C" stroke-width="0.3" opacity="0.25" transform="translate(0,5)"
    ></path>
  </svg>
</div>

<style>
  .ink-divider {
    position: relative;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: -8px;
  }
  .ink-divider svg {
    width: clamp(120px, 20vw, 280px);
    height: 24px;
    overflow: visible;
  }
</style>
