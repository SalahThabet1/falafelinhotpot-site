---
import Item from '~/components/blog/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  posts: Array<Post>;
}

const { posts } = Astro.props;
---

<ul class="editions-list">
  {
    posts.map((post) => (
      <li class="editions-list__item">
        <Item post={post} />
      </li>
    ))
  }
</ul>

<style>
  .editions-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0 0 3rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .editions-list {
      gap: 1.5rem;
    }
  }
</style>
