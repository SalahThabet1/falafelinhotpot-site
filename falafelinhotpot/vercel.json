{
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download/business-chinese",
      "destination": "/api/download/business-chinese"
    }
  ],
  "redirects": [
    { "source": "/newsletter", "destination": "/subscribe", "permanent": true },
    {
      "source": "/newsletter/archive",
      "destination": "/editions",
      "permanent": true
    },
    { "source": "/blog", "destination": "/editions", "permanent": true },
    {
      "source": "/blog/:path*",
      "destination": "/editions/:path*",
      "permanent": true
    },
    { "source": "/archive", "destination": "/editions", "permanent": true },
    {
      "source": "/archive/:path*",
      "destination": "/editions/:path*",
      "permanent": true
    },
    {
      "source": "/mandarin-starterkit-course",
      "destination": "/mandarin-starterkit-course/",
      "permanent": true
    },
    {
      "source": "/courses/7-day-mandarin",
      "destination": "/mandarin-starterkit-course/",
      "permanent": true
    },
    { "source": "/links", "destination": "/", "permanent": true }
  ]
}
